#!/bin/sh
# Ставится как .git/hooks/post-merge: sh scripts/install-hooks.sh
#
# Сессии бота работают в git worktree и делят с основным деревом каталог хуков.
# Без первой проверки деплой уезжал бы с ветки сессии в тот момент, когда она
# подтягивает к себе main.
[ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] || exit 0
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0

ROOT=$(git rev-parse --show-toplevel)
mkdir -p "$ROOT/data"

LOG=$ROOT/data/deploy.log

# Хук выполняется внутри git merge, которого ждёт бот, а сборка образа занимает
# под минуту, поэтому деплой в любом случае уходит в сторону.
#
# Через systemd, а не просто в фон: мерж может прийти из песочницы сессии, где
# сокета докера нет вовсе («no such file or directory» в логе деплоя), а
# пользовательский systemd всегда запускает в хостовом пространстве имён.
if command -v systemd-run >/dev/null 2>&1 &&
  systemd-run --user --collect --quiet \
    --unit="wiki-deploy-$(date +%s)" \
    --description="Обновление вики после мержа в main" \
    /bin/sh -c "sh '$ROOT/deploy.sh' >> '$LOG' 2>&1" 2>>"$LOG"
then
  exit 0
fi

echo "$(date '+%F %T') systemd-run недоступен, деплой запущен напрямую" >> "$LOG"
setsid sh "$ROOT/deploy.sh" >> "$LOG" 2>&1 < /dev/null &
exit 0
